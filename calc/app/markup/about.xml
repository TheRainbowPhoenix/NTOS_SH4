<Page name="AboutPage">
  <!-- About page per refs/calc-screens/calc_about.png: header 24-72
       (hamburger + ABOUT, no history icon); white page; "Calculator"
       light title y64-82; version + (c) lines y109-152; Terms of Use and
       Privacy Statement as accent-blue underlined links; Send feedback
       as a #B5B2B5 button x12-131 y259-290. Version/copyright strings
       reflect the ported package (10.1605.1582.0, (c) 2016). -->
  <Canvas>
    <Rect x="0" y="24" w="320" h="456" bg="#FFFFFF"/>
    <Canvas x="0" y="24" w="320" h="48">
      <Button name="NavButton" x="8" y="0" w="48" h="48" command="nav">
        <Glyph x="14" y="12" w="20" h="10" text="hamburger" color="#636563"/>
      </Button>
      <Text x="60" y="12" w="120" text="ABOUT" size="14" bold="1" color="#000000"/>
    </Canvas>
    <Text x="12" y="64" w="240" text="Calculator" size="22" color="#000000"/>
    <Text x="12" y="109" w="240" text="Version 10.1605.1582.0" size="12" color="#636563"/>
    <Text x="13" y="125" w="240" text="© 2016 Microsoft Corporation. All" size="12" color="#636563"/>
    <Text x="13" y="141" w="240" text="rights reserved." size="12" color="#636563"/>
    <Text name="Terms" x="12" y="181" w="200" text="Terms of Use" size="12" color="#3965FF" underline="1"/>
    <Text name="Privacy" x="12" y="220" w="200" text="Privacy Statement" size="12" color="#3965FF" underline="1"/>
    <Button name="Feedback" x="12" y="259" w="119" h="31" command="feedback" bg="#B5B2B5">
      <Text x="0" y="8" w="119" text="Send feedback" align="1" size="14" color="#000000"/>
    </Button>
  </Canvas>
</Page>
