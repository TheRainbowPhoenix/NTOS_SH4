<Page name="SciPage">
  <!-- Scientific mode, geometry per refs/calc-screens/calc_scientific.png:
       header 24-72 (hamburger + SCIENTIFIC + history icon); white display
       24-157, result right-aligned (y91-111); angle row DEG/HYP/F-E at
       y137-146; hairline y157; memory row 157-191; hairline y191; then the
       7x5 keypad: rows 1-2 on white 192-274, rows 3-7 on the #F7F3F7 shade
       274-480 (rows 41.5px, cols x0/64/128/192/256, label rows
       y205/246/286/328/370/411/453). R1/R2 labels are painted live by the
       app (2nd + HYP swap the sets); R3-R7 are static markup:
       2nd CE C BACK DIV / PI 7 8 9 TIMES / N! 4 5 6 MINUS
       / NEG 1 2 3 PLUS / ( ) 0 . EQUALS. -->
  <Canvas>
    <Canvas x="0" y="24" w="320" h="250">
      <Rect x="0" y="0" w="320" h="250" bg="#FFFFFF"/>
      <Canvas x="0" y="0" w="320" h="48">
        <Button name="NavButton" x="8" y="0" w="48" h="48" command="nav">
          <Glyph x="14" y="12" w="20" h="10" text="hamburger" color="#636563"/>
        </Button>
        <Text name="ModeTitle" x="60" y="12" w="170" text="SCIENTIFIC" size="14" bold="1" color="#000000"/>
        <Button name="HistoryButton" x="264" y="0" w="56" h="48" command="history">
          <Glyph x="289" y="11" w="16" h="16" text="history" color="#636563"/>
        </Button>
      </Canvas>
      <!-- angle row (labels painted live: DEG shows the active unit) -->
      <Button name="AngCycle" x="6" y="106" w="52" h="28" command="angle:cycle"/>
      <Button name="HypB" x="58" y="106" w="60" h="28" command="hyp"/>
      <Button name="FeB" x="112" y="106" w="52" h="28" command="fe"/>
      <Rect x="0" y="133" w="320" h="1" bg="#E7E7E7"/>
      <!-- memory row 157-191 -->
      <Button name="MC" x="0" y="134" w="53" h="34" command="mc"/>
      <Button name="MR" x="53" y="134" w="54" h="34" command="mr"/>
      <Button name="MPlus" x="107" y="134" w="53" h="34" command="m+"/>
      <Button name="MMinus" x="160" y="134" w="53" h="34" command="m-"/>
      <Button name="MS" x="213" y="134" w="53" h="34" command="ms"/>
      <Button name="MList" x="266" y="134" w="54" h="34" command="mlist"/>
      <!-- keypad row 1 (abs 192-233): x2 xy sin cos tan - labels live -->
      <Canvas x="0" y="168" w="320" h="41">
        <Button name="Sq" x="0" y="0" w="64" h="41" command="op:sqr"/>
        <Button name="PowY" x="64" y="0" w="64" h="41" command="op:powy"/>
        <Button name="Sin" x="128" y="0" w="64" h="41" command="fn:sin"/>
        <Button name="Cos" x="192" y="0" w="64" h="41" command="fn:cos"/>
        <Button name="Tan" x="256" y="0" w="64" h="41" command="fn:tan"/>
      </Canvas>
      <!-- keypad row 2 (abs 233-274): sqrt 10x log Exp Mod - labels live -->
      <Canvas x="0" y="209" w="320" h="41">
        <Button name="Sqrt" x="0" y="0" w="64" h="41" command="op:sqrt"/>
        <Button name="TenPow" x="64" y="0" w="64" h="41" command="op:tenpow"/>
        <Button name="Log" x="128" y="0" w="64" h="41" command="fn:log"/>
        <Button name="ExpB" x="192" y="0" w="64" h="41" command="fn:exp"/>
        <Button name="Mod" x="256" y="0" w="64" h="41" command="op:mod"/>
      </Canvas>
    </Canvas>
    <Rect x="0" y="191" w="320" h="1" bg="#E7E7E7"/>
    <!-- shaded band 274-480: keypad rows 3-7 -->
    <Canvas x="0" y="274" w="320" h="206">
      <Rect x="0" y="0" w="320" h="206" bg="#F7F3F7"/>
      <Canvas x="0" y="0" w="320" h="42">
        <Button name="Second" x="0" y="0" w="64" h="42" command="second">
          <Glyph x="24" y="12" w="16" h="16" text="up" color="#636563"/>
        </Button>
        <Button name="CE" x="64" y="0" w="64" h="42" command="op:ce">
          <Text x="0" y="12" w="64" text="CE" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="C" x="128" y="0" w="64" h="42" command="op:c">
          <Text x="0" y="12" w="64" text="C" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="Back" x="192" y="0" w="64" h="42" command="op:back">
          <Glyph x="24" y="12" w="24" h="14" text="backspace" color="#000000"/>
        </Button>
        <Button name="Div" x="256" y="0" w="64" h="42" command="op:divide">
          <Glyph x="24" y="12" w="16" h="16" text="divide" color="#000000"/>
        </Button>
      </Canvas>
      <Canvas x="0" y="42" w="320" h="42">
        <Button name="Pi" x="0" y="0" w="64" h="42" command="op:pi">
          <Glyph x="24" y="12" w="16" h="16" text="pi" color="#000000"/>
        </Button>
        <Button name="D7" x="64" y="0" w="64" h="42" command="d:7">
          <Text x="0" y="12" w="64" text="7" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="D8" x="128" y="0" w="64" h="42" command="d:8">
          <Text x="0" y="12" w="64" text="8" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="D9" x="192" y="0" w="64" h="42" command="d:9">
          <Text x="0" y="12" w="64" text="9" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="Mul" x="256" y="0" w="64" h="42" command="op:times">
          <Glyph x="24" y="12" w="16" h="16" text="times" color="#000000"/>
        </Button>
      </Canvas>
      <Canvas x="0" y="84" w="320" h="42">
        <Button name="Fact" x="0" y="0" w="64" h="42" command="fn:fact">
          <Text x="0" y="13" w="64" text="n!" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="D4" x="64" y="0" w="64" h="42" command="d:4">
          <Text x="0" y="13" w="64" text="4" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="D5" x="128" y="0" w="64" h="42" command="d:5">
          <Text x="0" y="13" w="64" text="5" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="D6" x="192" y="0" w="64" h="42" command="d:6">
          <Text x="0" y="13" w="64" text="6" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="Sub" x="256" y="0" w="64" h="42" command="op:minus">
          <Glyph x="24" y="13" w="16" h="16" text="minus" color="#000000"/>
        </Button>
      </Canvas>
      <Canvas x="0" y="126" w="320" h="41">
        <Button name="Neg" x="0" y="0" w="64" h="41" command="op:negate">
          <Glyph x="24" y="12" w="16" h="16" text="negate" color="#000000"/>
        </Button>
        <Button name="D1" x="64" y="0" w="64" h="41" command="d:1">
          <Text x="0" y="12" w="64" text="1" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="D2" x="128" y="0" w="64" h="41" command="d:2">
          <Text x="0" y="12" w="64" text="2" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="D3" x="192" y="0" w="64" h="41" command="d:3">
          <Text x="0" y="12" w="64" text="3" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="Add" x="256" y="0" w="64" h="41" command="op:plus">
          <Glyph x="24" y="12" w="16" h="16" text="plus" color="#000000"/>
        </Button>
      </Canvas>
      <Canvas x="0" y="167" w="320" h="39">
        <Button name="Pl" x="0" y="0" w="64" h="39" command="op:pl">
          <Text x="0" y="13" w="64" text="(" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="Pr" x="64" y="0" w="64" h="39" command="op:pr">
          <Text x="0" y="13" w="64" text=")" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="D0" x="128" y="0" w="64" h="39" command="d:0">
          <Text x="0" y="13" w="64" text="0" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="Dot" x="192" y="0" w="64" h="39" command="d:.">
          <Text x="0" y="13" w="64" text="." align="1" size="16" color="#000000"/>
        </Button>
        <Button name="Eq" x="256" y="0" w="64" h="39" command="op:eq">
          <Glyph x="24" y="13" w="16" h="16" text="equal" color="#000000"/>
        </Button>
      </Canvas>
    </Canvas>
  </Canvas>
</Page>
