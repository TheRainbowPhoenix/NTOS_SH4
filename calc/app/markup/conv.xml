<Page name="ConvPage">
  <!-- Unit converter, geometry per refs/calc-screens/volume.png:
       header 24-72 (hamburger + category title, NO history icon); white
       page with two unit blocks: value1 (24px, left x13) y85-115, unit1
       name in accent blue + chevron y131-141, value2 y173-189, unit2 name
       y211-224; then the keypad on the #F7F3F7 shade 280-480: 3 columns
       (0.25*|*|*|*|0.25* grid => centers 69/160/251) x 5 rows of 40px
       (label rows y299/340/380/420/460):
       [ - CE BACK ] / 7 8 9 / 4 5 6 / 1 2 3 / [ - 0 . ]
       Values, unit names and the mode title are painted live by the app. -->
  <Canvas>
    <Canvas x="0" y="24" w="320" h="256">
      <Rect x="0" y="0" w="320" h="256" bg="#FFFFFF"/>
      <Canvas x="0" y="0" w="320" h="48">
        <Button name="NavButton" x="8" y="0" w="48" h="48" command="nav">
          <Glyph x="14" y="12" w="20" h="10" text="hamburger" color="#636563"/>
        </Button>
      </Canvas>
      <!-- unit block 1: value row (tap = make active) + name row
           (tap = open the unit picker sheet); both painted live -->
      <Button name="Pick1" x="4" y="58" w="196" h="42" command="pick:1"/>
      <Button name="Units1" x="4" y="100" w="196" h="24" command="units:1"/>
      <!-- unit block 2 -->
      <Button name="Pick2" x="4" y="142" w="196" h="38" command="pick:2"/>
      <Button name="Units2" x="4" y="180" w="196" h="24" command="units:2"/>
    </Canvas>
    <Canvas x="0" y="280" w="320" h="200">
      <Rect x="0" y="0" w="320" h="200" bg="#F7F3F7"/>
      <Canvas x="0" y="0" w="320" h="40">
        <Button name="CE" x="116" y="0" w="93" h="40" command="op:ce">
          <Text x="0" y="13" w="93" text="CE" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="Back" x="209" y="0" w="93" h="40" command="op:back">
          <Glyph x="29" y="13" w="20" h="14" text="backspace" color="#000000"/>
        </Button>
      </Canvas>
      <Canvas x="0" y="40" w="320" h="40">
        <Button name="D7" x="23" y="0" w="93" h="40" command="d:7">
          <Text x="0" y="12" w="93" text="7" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="D8" x="116" y="0" w="93" h="40" command="d:8">
          <Text x="0" y="12" w="93" text="8" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="D9" x="209" y="0" w="93" h="40" command="d:9">
          <Text x="0" y="12" w="93" text="9" align="1" size="16" color="#000000"/>
        </Button>
      </Canvas>
      <Canvas x="0" y="80" w="320" h="40">
        <Button name="D4" x="23" y="0" w="93" h="40" command="d:4">
          <Text x="0" y="12" w="93" text="4" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="D5" x="116" y="0" w="93" h="40" command="d:5">
          <Text x="0" y="12" w="93" text="5" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="D6" x="209" y="0" w="93" h="40" command="d:6">
          <Text x="0" y="12" w="93" text="6" align="1" size="16" color="#000000"/>
        </Button>
      </Canvas>
      <Canvas x="0" y="120" w="320" h="40">
        <Button name="D1" x="23" y="0" w="93" h="40" command="d:1">
          <Text x="0" y="12" w="93" text="1" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="D2" x="116" y="0" w="93" h="40" command="d:2">
          <Text x="0" y="12" w="93" text="2" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="D3" x="209" y="0" w="93" h="40" command="d:3">
          <Text x="0" y="12" w="93" text="3" align="1" size="16" color="#000000"/>
        </Button>
      </Canvas>
      <Canvas x="0" y="160" w="320" h="40">
        <Button name="D0" x="116" y="0" w="93" h="40" command="d:0">
          <Text x="0" y="12" w="93" text="0" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="Dot" x="209" y="0" w="93" h="40" command="d:.">
          <Text x="0" y="12" w="93" text="." align="1" size="16" color="#000000"/>
        </Button>
      </Canvas>
    </Canvas>
  </Canvas>
</Page>
