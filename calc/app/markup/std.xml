<Page name="StdPage">
  <!-- Standard mode, geometry per the refs/calc-screens captures: system
       status bar y0-24 + nav y480-528 are SHELLCHROME-owned; this page
       owns 24..480. Header row 24-72 (hamburger x14-34 y36-46, mode title
       x60, history icon x289-304); display white 24-184 (expression y64
       right, result 44px right to x305, memory row 152-184); hairline
       y184; % operator row on white 185-240; numpad shade #F7F3F7
       240-480, 5 rows of 48px, label rows y251/300/350/399/449,
       cols x0/80/160/240 (centers 40/120/200/280).
       NOTE: Button-child coordinates are RELATIVE to the button. -->
  <Canvas>
    <Canvas x="0" y="24" w="320" h="160">
      <Rect x="0" y="0" w="320" h="160" bg="#FFFFFF"/>
      <Button name="NavButton" x="8" y="0" w="48" h="48" command="nav">
        <Glyph x="6" y="12" w="20" h="10" text="hamburger" color="#636563"/>
      </Button>
      <Text name="ModeTitle" x="60" y="12" w="170" text="STANDARD" size="14" bold="1" color="#000000"/>
      <Button name="HistoryButton" x="264" y="0" w="56" h="48" command="history">
        <Glyph x="25" y="11" w="16" h="16" text="history" color="#636563"/>
      </Button>
      <Button name="MC" x="0" y="128" w="53" h="32" command="mc"/>
      <Button name="MR" x="53" y="128" w="54" h="32" command="mr"/>
      <Button name="MPlus" x="107" y="128" w="53" h="32" command="m+"/>
      <Button name="MMinus" x="160" y="128" w="53" h="32" command="m-"/>
      <Button name="MS" x="213" y="128" w="53" h="32" command="ms"/>
      <Button name="MList" x="266" y="128" w="54" h="32" command="mlist"/>
    </Canvas>
    <Rect x="0" y="184" w="320" h="1" bg="#E7E7E7"/>
    <!-- % sqrt x2 1/x row on white, labels y202 (canvas y185 + 17) -->
    <Canvas x="0" y="185" w="320" h="55">
      <Rect x="0" y="0" w="320" h="55" bg="#FFFFFF"/>
      <Button name="Percent" x="0" y="0" w="80" h="55" command="op:percent">
        <Glyph x="28" y="17" w="24" h="16" text="percent" color="#000000"/>
      </Button>
      <Button name="Sqrt" x="80" y="0" w="80" h="55" command="op:sqrt">
        <Glyph x="28" y="17" w="24" h="16" text="sqrt" color="#000000"/>
      </Button>
      <Button name="XSq" x="160" y="0" w="80" h="55" command="op:sqr">
        <Glyph x="28" y="17" w="24" h="16" text="xpow2" color="#000000"/>
      </Button>
      <Button name="Inv" x="240" y="0" w="80" h="55" command="op:invert">
        <Glyph x="28" y="17" w="24" h="16" text="invert" color="#000000"/>
      </Button>
    </Canvas>
    <!-- numpad #F7F3F7 240-480: 5 rows of 48px -->
    <Canvas x="0" y="240" w="320" h="240">
      <Rect x="0" y="0" w="320" h="240" bg="#F7F3F7"/>
      <Canvas x="0" y="0" w="320" h="48">
        <Button name="CE" x="0" y="0" w="80" h="48" command="op:ce">
          <Text x="0" y="11" w="80" text="CE" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="C" x="80" y="0" w="80" h="48" command="op:c">
          <Text x="0" y="11" w="80" text="C" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="Back" x="160" y="0" w="80" h="48" command="op:back">
          <Glyph x="28" y="11" w="24" h="14" text="backspace" color="#000000"/>
        </Button>
        <Button name="Div" x="240" y="0" w="80" h="48" command="op:divide">
          <Glyph x="28" y="11" w="24" h="16" text="divide" color="#000000"/>
        </Button>
      </Canvas>
      <Canvas x="0" y="48" w="320" h="48">
        <Button name="D7" x="0" y="0" w="80" h="48" command="d:7">
          <Text x="0" y="12" w="80" text="7" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="D8" x="80" y="0" w="80" h="48" command="d:8">
          <Text x="0" y="12" w="80" text="8" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="D9" x="160" y="0" w="80" h="48" command="d:9">
          <Text x="0" y="12" w="80" text="9" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="Mul" x="240" y="0" w="80" h="48" command="op:times">
          <Glyph x="28" y="12" w="24" h="16" text="times" color="#000000"/>
        </Button>
      </Canvas>
      <Canvas x="0" y="96" w="320" h="48">
        <Button name="D4" x="0" y="0" w="80" h="48" command="d:4">
          <Text x="0" y="14" w="80" text="4" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="D5" x="80" y="0" w="80" h="48" command="d:5">
          <Text x="0" y="14" w="80" text="5" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="D6" x="160" y="0" w="80" h="48" command="d:6">
          <Text x="0" y="14" w="80" text="6" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="Sub" x="240" y="0" w="80" h="48" command="op:minus">
          <Glyph x="28" y="14" w="24" h="16" text="minus" color="#000000"/>
        </Button>
      </Canvas>
      <Canvas x="0" y="144" w="320" h="48">
        <Button name="D1" x="0" y="0" w="80" h="48" command="d:1">
          <Text x="0" y="15" w="80" text="1" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="D2" x="80" y="0" w="80" h="48" command="d:2">
          <Text x="0" y="15" w="80" text="2" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="D3" x="160" y="0" w="80" h="48" command="d:3">
          <Text x="0" y="15" w="80" text="3" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="Add" x="240" y="0" w="80" h="48" command="op:plus">
          <Glyph x="28" y="15" w="24" h="16" text="plus" color="#000000"/>
        </Button>
      </Canvas>
      <Canvas x="0" y="192" w="320" h="48">
        <Button name="Neg" x="0" y="0" w="80" h="48" command="op:negate">
          <Glyph x="28" y="17" w="24" h="16" text="negate" color="#000000"/>
        </Button>
        <Button name="D0" x="80" y="0" w="80" h="48" command="d:0">
          <Text x="0" y="17" w="80" text="0" align="1" size="16" color="#000000"/>
        </Button>
        <Button name="Dot" x="160" y="0" w="80" h="48" command="d:.">
          <Text x="0" y="17" w="80" text="." align="1" size="16" color="#000000"/>
        </Button>
        <Button name="Eq" x="240" y="0" w="80" h="48" command="op:eq">
          <Glyph x="28" y="17" w="24" h="16" text="equal" color="#000000"/>
        </Button>
      </Canvas>
    </Canvas>
  </Canvas>
</Page>
