#undef NTOS_EXWORD_EXPORT
u32 ntos_exword_lookup_coredll(const char *name)
{
    if(!name)return 0;
    for(unsigned i=0;i<sizeof ntos_core_exports/sizeof ntos_core_exports[0];++i) {
        const char *a=ntos_core_exports[i].name,*b=name;
        while(*a && *a==*b){++a;++b;}
        if(*a==0 && *b==0)return ntos_core_exports[i].target;
    }
    return 0;
}
