<Page name="TabCenterPage">
  <Canvas>
    <!-- per tabs.png/manytabs.png: black page, "Tabs" title, 2-col card grid
         at x12/x166 (142 wide), toolbar with + / InPrivate / ... right -->
    <Rect x="0" y="0" w="320" h="480" bg="#000000"/>
    <Text x="12" y="17" text="Tabs" color="#FFFFFF" size="14" bold="true"/>
    <Rect x="0" y="480" w="320" h="48" bg="#1F1F1F"/>
    <Button name="TabsCenter_NewTabButton" x="135" y="480" w="56" h="48" command="newtab">
      <Glyph x="18" y="16" w="20" h="20" text="plus" color="#FFFFFF"/>
    </Button>
    <Button name="TabsCenter_NewPrivateButton" x="200" y="480" w="56" h="48" command="newprivate">
      <Glyph x="28" y="16" w="20" h="20" text="inprivate" color="#FFFFFF"/>
    </Button>
    <Button name="TabsCenter_MoreButton" x="256" y="480" w="64" h="48" command="tabsmenu">
      <Glyph x="25" y="17" w="22" h="18" text="more" color="#FFFFFF"/>
    </Button>
  </Canvas>
</Page>
