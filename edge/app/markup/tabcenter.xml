<Page name="TabCenterPage">
  <Canvas>
    <Rect x="0" y="0" w="320" h="528" bg="#000000"/>
    <Button name="TabsBack" x="0" y="0" w="48" h="48" command="tabs-back">
      <Glyph x="14" y="14" w="20" h="20" text="back" color="#FFFFFF"/>
    </Button>
    <Text x="160" y="14" w="320" text="Tabs" color="#FFFFFF" size="18" bold="true" align="1"/>
    <!-- tab cards painted procedurally: 2-column grid (TabsCustomGridView) -->
    <Rect name="TabGridHost" x="8" y="56" w="304" h="420" bg="#000000"/>
    <Rect x="0" y="472" w="320" h="1" bg="#464646"/>
    <!-- bottom toolbar, right-padded: new tab / new InPrivate tab / tabs menu -->
    <Button name="NewTabButton" x="148" y="480" w="48" h="48" command="newtab">
      <Glyph x="12" y="12" w="24" h="24" text="plus" color="#FFFFFF"/>
    </Button>
    <Button name="NewInPrivateTabButton" x="204" y="480" w="48" h="48" command="newprivate">
      <Glyph x="12" y="12" w="24" h="24" text="inprivate" color="#FFFFFF"/>
    </Button>
    <Button name="TabsMenuButton" x="260" y="480" w="48" h="48" command="tabsmenu">
      <Glyph x="12" y="12" w="24" h="24" text="more" color="#FFFFFF"/>
    </Button>
  </Canvas>
</Page>
