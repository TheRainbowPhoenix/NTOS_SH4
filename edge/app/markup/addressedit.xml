<Page name="AddressEditBoxPage">
  <Canvas>
    <!-- Address edit stack, authored at DARK geometry (type.png):
         separator strip y223-230, white field x5-314 y230-269, then the
         toolbar row + shared fingerkb SIP from y270. The light theme
         shifts the whole doc up 48px (fixes_1/test123_input.png:
         strip y175-182 #E7E7E7, field y182-222, toolbar y223-269
         #DEDFDE, SIP 269-478, SHELLCHROME nav bar 480-528) and the app
         paints the page area above it: live while text is present,
         dimmed through DimRect when the field is empty. -->
    <Rect x="0" y="223" w="320" h="7" bg="#1F1F1F"/>
    <Rect x="5" y="230" w="310" h="40" bg="#FFFFFF"/>
    <Button name="AddressInput" x="5" y="230" w="310" h="40" command="noop">
      <Text name="AddrEditHint" x="13" y="14" text="Search or browse" color="#767676" size="12"/>
    </Button>
  </Canvas>
</Page>
