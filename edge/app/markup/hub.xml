<Page name="HubPanel">
  <Canvas>
    <Rect x="0" y="0" w="320" h="528" bg="#000000"/>
    <Button name="HubBack" x="0" y="0" w="48" h="48" command="hub-back">
      <Glyph x="14" y="14" w="20" h="20" text="back" color="#FFFFFF"/>
    </Button>
    <Text name="HubTitle" x="160" y="14" w="320" text="Favorites" color="#FFFFFF" size="18" bold="true" align="1"/>
    <Button name="HubClear" x="256" y="10" w="60" h="30" command="hubclear" visible="false">
      <Text name="HubClearText" x="0" y="8" w="60" text="Clear all" color="#0078D7" size="11" align="1"/>
    </Button>
    <!-- pivot header: Favorites / Reading list / History / Downloads -->
    <Button x="0" y="56" w="80" h="44" command="pivot-0">
      <Text name="Pivot0" x="0" y="15" w="80" text="Favorites" color="#9A9A9A" size="12" align="1"/>
    </Button>
    <Button x="80" y="56" w="80" h="44" command="pivot-1">
      <Text name="Pivot1" x="0" y="15" w="80" text="Reading list" color="#9A9A9A" size="12" align="1"/>
    </Button>
    <Button x="160" y="56" w="80" h="44" command="pivot-2">
      <Text name="Pivot2" x="0" y="15" w="80" text="History" color="#9A9A9A" size="12" align="1"/>
    </Button>
    <Button x="240" y="56" w="80" h="44" command="pivot-3">
      <Text name="Pivot3" x="0" y="15" w="80" text="Downloads" color="#9A9A9A" size="12" align="1"/>
    </Button>
    <Rect x="0" y="100" w="320" h="1" bg="#464646"/>
    <!-- pivot content painted procedurally (104..528) -->
    <Rect name="HubContentHost" x="0" y="104" w="320" h="424" bg="#000000"/>
  </Canvas>
</Page>
