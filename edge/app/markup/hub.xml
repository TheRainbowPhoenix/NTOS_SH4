<Page name="HubPanel">
  <Canvas>
    <!-- per history.png/edge4.png: fullscreen black, 4 pivot icons at
         centers x22/66/110/154, blue underline under the active pivot,
         pivot title + "Clear all history" link row, content below. -->
    <Rect x="0" y="0" w="320" h="528" bg="#000000"/>
    <Button name="Pivot0" x="0" y="0" w="48" h="48" command="pivot-0">
      <Glyph name="PivotIcon0" x="14" y="11" w="16" h="16" text="star" color="#FFFFFF"/>
    </Button>
    <Button name="Pivot1" x="44" y="0" w="48" h="48" command="pivot-1">
      <Glyph name="PivotIcon1" x="14" y="11" w="16" h="16" text="readlist" color="#FFFFFF"/>
    </Button>
    <Button name="Pivot2" x="88" y="0" w="48" h="48" command="pivot-2">
      <Glyph name="PivotIcon2" x="14" y="11" w="16" h="16" text="clock" color="#FFFFFF"/>
    </Button>
    <Button name="Pivot3" x="132" y="0" w="48" h="48" command="pivot-3">
      <Glyph name="PivotIcon3" x="14" y="11" w="16" h="16" text="download" color="#FFFFFF"/>
    </Button>
    <Text name="HubTitle" x="12" y="60" text="Favorites" color="#FFFFFF" size="14" bold="true"/>
    <Button name="HubClear" x="196" y="58" w="112" h="24" command="hubclear">
      <Text x="0" y="3" w="112" text="Clear all history" color="#0078D7" size="12" align="2"/>
    </Button>
  </Canvas>
</Page>
