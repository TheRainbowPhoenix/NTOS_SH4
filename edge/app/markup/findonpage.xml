<Page name="FindOnPageBar">
  <Canvas>
    <!-- bar painted over the browser page by the app -->
    <Rect x="0" y="0" w="320" h="44" bg="#2B2B2B"/>
    <Button name="FindClose" x="0" y="0" w="40" h="44" command="find-close">
      <Glyph x="12" y="14" w="16" h="16" text="close" color="#FFFFFF"/>
    </Button>
    <TextBox name="FindInput" x="44" y="8" w="200" h="28" bg="#1F1F1F" radius="2" text="Find on page"/>
    <Text x="252" y="16" text="1/3" color="#9A9A9A" size="11"/>
  </Canvas>
</Page>
