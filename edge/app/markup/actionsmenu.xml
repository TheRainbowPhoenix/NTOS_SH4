<Page name="ActionsMenu">
  <Canvas>
    <!-- sheet geometry per refs/edge-screens/context.png:
         scrim 0..156 over the page, list 157..419 (#2B2B2B, 6 x 44 rows),
         hub icon bar 420..476 (#1F1F1F); the address bar stays visible. -->
    <Rect name="Scrim" x="0" y="0" w="320" h="157" bg="#7F7F7F"/>
    <Rect x="0" y="157" w="320" h="263" bg="#2B2B2B"/>
    <Button name="MenuForward" x="0" y="157" w="320" h="44" command="fwd">
      <Text x="13" y="12" text="Go forward" color="#8C8C8C" size="14"/>
    </Button>
    <Button name="MenuShare" x="0" y="201" w="320" h="44" command="share">
      <Text x="13" y="12" text="Share" color="#FFFFFF" size="14"/>
    </Button>
    <Button name="MenuAddFav" x="0" y="245" w="320" h="44" command="addfav">
      <Text x="13" y="12" text="Add to favorites" color="#FFFFFF" size="14"/>
    </Button>
    <Button name="MenuAddRead" x="0" y="289" w="320" h="44" command="addread">
      <Text x="13" y="12" text="Add to reading list" color="#FFFFFF" size="14"/>
    </Button>
    <Button name="MenuFind" x="0" y="333" w="320" h="44" command="findonpage">
      <Text x="13" y="12" text="Find on page" color="#FFFFFF" size="14"/>
    </Button>
    <Button name="MenuPin" x="0" y="377" w="320" h="42" command="pintostart">
      <Text x="13" y="12" text="Pin this page to Start" color="#FFFFFF" size="14"/>
    </Button>
    <!-- hub icon bar: Favorites / Reading list / History / Downloads
         (context.png: icon strip is continuous #1F1F1F down to the address
         bar at y480 — no white gap; icons y434-454, labels y464) -->
    <Rect x="0" y="420" w="320" h="60" bg="#1F1F1F"/>
    <Button x="35" y="420" w="80" h="60" command="hub-favorites">
      <Glyph x="30" y="14" w="20" h="20" text="star" color="#FFFFFF"/>
      <Text x="0" y="44" w="80" text="Favorites" color="#FFFFFF" size="11" align="1"/>
    </Button>
    <Button x="104" y="420" w="80" h="60" command="hub-reading">
      <Glyph x="30" y="14" w="20" h="20" text="readlist" color="#FFFFFF"/>
      <Text x="0" y="44" w="80" text="Reading list" color="#FFFFFF" size="11" align="1"/>
    </Button>
    <Button x="172" y="420" w="80" h="60" command="hub-history">
      <Glyph x="30" y="14" w="20" h="20" text="clock" color="#FFFFFF"/>
      <Text x="0" y="44" w="80" text="History" color="#FFFFFF" size="11" align="1"/>
    </Button>
    <Button x="240" y="420" w="80" h="60" command="hub-downloads">
      <Glyph x="30" y="14" w="20" h="20" text="download" color="#FFFFFF"/>
      <Text x="0" y="44" w="80" text="Downloads" color="#FFFFFF" size="11" align="1"/>
    </Button>
  </Canvas>
</Page>
