<Page name="ActionsMenu">
  <Canvas>
    <!-- bottom sheet; browser + scrim painted behind by the app -->
    <Rect x="0" y="136" w="320" h="392" bg="#2B2B2B" radius="6"/>
    <List x="0" y="140" w="320" h="308">
      <Button x="0" y="0" w="320" h="44" command="fwd">
        <Glyph name="GoForwardIcon" x="20" y="12" w="20" h="20" text="forward" color="#6E6E6E"/>
        <Text name="GoForwardText" x="56" y="15" text="Go forward" color="#9A9A9A" size="14"/>
      </Button>
      <Button x="0" y="0" w="320" h="44" command="share">
        <Glyph x="20" y="12" w="20" h="20" text="share" color="#FFFFFF"/>
        <Text x="56" y="15" text="Share" color="#FFFFFF" size="14"/>
      </Button>
      <Button x="0" y="0" w="320" h="44" command="addfav">
        <Glyph x="20" y="12" w="20" h="20" text="star" color="#FFFFFF"/>
        <Text x="56" y="15" text="Add to favorites" color="#FFFFFF" size="14"/>
      </Button>
      <Button x="0" y="0" w="320" h="44" command="addread">
        <Glyph x="20" y="12" w="20" h="20" text="book" color="#FFFFFF"/>
        <Text x="56" y="15" text="Add to reading list" color="#FFFFFF" size="14"/>
      </Button>
      <Button x="0" y="0" w="320" h="44" command="findonpage">
        <Glyph x="20" y="12" w="20" h="20" text="find" color="#FFFFFF"/>
        <Text x="56" y="15" text="Find on page" color="#FFFFFF" size="14"/>
      </Button>
      <Button x="0" y="0" w="320" h="44" command="pintostart">
        <Glyph x="20" y="12" w="20" h="20" text="pin" color="#FFFFFF"/>
        <Text x="56" y="15" text="Pin this page to Start" color="#FFFFFF" size="14"/>
      </Button>
      <Button x="0" y="0" w="320" h="44" command="settings">
        <Glyph x="20" y="12" w="20" h="20" text="settings" color="#FFFFFF"/>
        <Text x="56" y="15" text="Settings" color="#FFFFFF" size="14"/>
      </Button>
    </List>
    <Rect x="0" y="452" w="320" h="1" bg="#464646"/>
    <!-- hub quick icons: Favorites / Reading list / History / Downloads -->
    <Button x="0" y="456" w="80" h="64" command="hub-favorites">
      <Glyph x="26" y="4" w="28" h="28" text="star" color="#FFFFFF"/>
      <Text x="0" y="38" w="80" text="Favorites" color="#9A9A9A" size="9" align="1"/>
    </Button>
    <Button x="80" y="456" w="80" h="64" command="hub-reading">
      <Glyph x="26" y="4" w="28" h="28" text="book" color="#FFFFFF"/>
      <Text x="0" y="38" w="80" text="Reading list" color="#9A9A9A" size="9" align="1"/>
    </Button>
    <Button x="160" y="456" w="80" h="64" command="hub-history">
      <Glyph x="26" y="4" w="28" h="28" text="clock" color="#FFFFFF"/>
      <Text x="0" y="38" w="80" text="History" color="#9A9A9A" size="9" align="1"/>
    </Button>
    <Button x="240" y="456" w="80" h="64" command="hub-downloads">
      <Glyph x="26" y="4" w="28" h="28" text="download" color="#FFFFFF"/>
      <Text x="0" y="38" w="80" text="Downloads" color="#9A9A9A" size="9" align="1"/>
    </Button>
  </Canvas>
</Page>
