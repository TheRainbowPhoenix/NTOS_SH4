    <Text x="36" y="246" text="your device after you're done." color="#FFFFFF" size="14"/>
    <Text x="36" y="267" text="Microsoft Edge deletes temporary" color="#FFFFFF" size="14"/>
    <Text x="36" y="288" text="data after all InPrivate tabs are" color="#FFFFFF" size="14"/>
    <Button name="PrivLink" x="36" y="344" w="220" h="20" command="priv-link">
      <Text x="0" y="0" text="Read the Microsoft privacy" color="#009BE4" size="14"/>
    </Button>
    <Text x="36" y="365" text="statement" color="#009BE4" size="14"/>
  </Canvas>
</Page>
