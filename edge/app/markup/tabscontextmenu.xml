<Page name="TabsContextMenu">
  <Canvas>
    <!-- flyout over the tab center; same list styling as the "..." sheet -->
    <Rect x="96" y="180" w="224" h="300" bg="#2B2B2B"/>
    <Button x="96" y="180" w="224" h="44" command="ctx-refresh-all">
      <Text x="13" y="11" text="Refresh all" color="#FFFFFF" size="14"/>
    </Button>
    <Button x="96" y="224" w="224" h="44" command="ctx-duplicate">
      <Text x="13" y="11" text="Duplicate tab" color="#FFFFFF" size="14"/>
    </Button>
    <Button x="96" y="268" w="224" h="44" command="ctx-close">
      <Text x="13" y="11" text="Close tab" color="#FFFFFF" size="14"/>
    </Button>
    <Button x="96" y="312" w="224" h="44" command="ctx-close-others">
      <Text x="13" y="11" text="Close other tabs" color="#FFFFFF" size="14"/>
    </Button>
    <Button x="96" y="356" w="224" h="44" command="ctx-close-right">
      <Text x="13" y="11" text="Close tabs to the right" color="#FFFFFF" size="14"/>
    </Button>
    <Button x="96" y="400" w="224" h="40" command="ctx-close-all">
      <Text x="13" y="11" text="Close all tabs" color="#FFFFFF" size="14"/>
    </Button>
    <Button x="96" y="440" w="224" h="40" command="ctx-reopen">
      <Text x="13" y="11" text="Reopen closed tabs" color="#FFFFFF" size="14"/>
    </Button>
  </Canvas>
</Page>
