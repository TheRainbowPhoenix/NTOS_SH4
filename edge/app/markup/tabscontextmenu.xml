<Page name="TabsContextMenu">
  <Canvas>
    <!-- flyout over the tab center, anchored bottom-right (no scrim) -->
    <Rect x="96" y="196" w="224" h="280" bg="#2B2B2B" radius="4"/>
    <List x="96" y="200" w="224" h="276">
      <Button x="0" y="0" w="224" h="40" command="ctx-refresh-all">
        <Text x="16" y="12" text="Refresh all" color="#FFFFFF" size="12"/>
      </Button>
      <Button x="0" y="0" w="224" h="40" command="ctx-duplicate">
        <Text x="16" y="12" text="Duplicate tab" color="#FFFFFF" size="12"/>
      </Button>
      <Button x="0" y="0" w="224" h="40" command="ctx-close">
        <Text x="16" y="12" text="Close tab" color="#FFFFFF" size="12"/>
      </Button>
      <Button x="0" y="0" w="224" h="40" command="ctx-close-others">
        <Text x="16" y="12" text="Close other tabs" color="#FFFFFF" size="12"/>
      </Button>
      <Button x="0" y="0" w="224" h="40" command="ctx-close-right">
        <Text x="16" y="12" text="Close tabs to the right" color="#FFFFFF" size="12"/>
      </Button>
      <Button x="0" y="0" w="224" h="40" command="ctx-close-all">
        <Text x="16" y="12" text="Close all tabs" color="#FFFFFF" size="12"/>
      </Button>
      <Button x="0" y="0" w="224" h="40" command="ctx-reopen">
        <Text x="16" y="12" text="Reopen closed tabs" color="#FFFFFF" size="12"/>
      </Button>
    </List>
  </Canvas>
</Page>
