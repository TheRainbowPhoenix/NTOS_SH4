<Page name="AddToReadingListDialog">
  <Canvas>
    <!-- per add_reading.png: fullscreen black page, READING LIST title,
         #333 preview hero y78..257 with the white reading-list glyph,
         Name label + bordered input, Add/Cancel buttons. -->
    <Rect x="0" y="0" w="320" h="528" bg="#000000"/>
    <Text x="12" y="15" text="READING LIST" color="#FFFFFF" size="18"/>
    <Rect x="0" y="78" w="320" h="180" bg="#333333"/>
    <Glyph x="132" y="170" w="56" h="56" text="readlist" color="#FFFFFF"/>
    <Text x="12" y="280" text="Name" color="#FFFFFF" size="14"/>
    <Button name="RLName" x="12" y="298" w="296" h="33" command="noop">
      <Text name="RLNameText" x="8" y="9" text="Test" color="#FFFFFF" size="14"/>
    </Button>
    <Button name="RLAdd" x="12" y="358" w="146" h="32" command="rl-add" bg="#2E2E2E">
      <Text x="0" y="9" w="146" text="Add" color="#FFFFFF" size="14" align="1"/>
    </Button>
    <Button name="RLCancel" x="162" y="358" w="146" h="32" command="dialog-cancel" bg="#2E2E2E">
      <Text x="0" y="9" w="146" text="Cancel" color="#FFFFFF" size="14" align="1"/>
    </Button>
  </Canvas>
</Page>
