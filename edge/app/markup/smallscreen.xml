<Page name="SmallScreenPage">
  <Canvas>
    <!-- content host (mock web engine paints 0..480) -->
    <Rect name="PageHost" x="0" y="0" w="320" h="480" bg="#000000"/>
    <!-- bottom address bar: [tabs] | [reload] [url] [reader] | [...] -->
    <Rect x="0" y="480" w="320" h="48" bg="#000000"/>
    <Button name="TabsButton" x="0" y="480" w="46" h="48" command="tabs">
      <Glyph x="11" y="12" w="24" h="24" text="tabs" color="#FFFFFF"/>
    </Button>
    <Text name="TabsCount" x="26" y="484" text="1" color="#0078D7" size="9" bold="true"/>
    <Rect x="46" y="492" w="1" h="24" bg="#464646"/>
    <Button name="ReloadButton" x="47" y="480" w="36" h="48" command="reload">
      <Glyph name="ReloadIcon" x="8" y="14" w="20" h="20" text="reload" color="#6E6E6E"/>
    </Button>
    <Button name="AddressButton" x="83" y="480" w="149" h="48" command="address">
      <Glyph name="AddressLock" x="5" y="17" w="14" h="14" text="lock" color="#9A9A9A" visible="false"/>
      <Text name="AddressText" x="23" y="18" text="Search or browse" color="#9A9A9A" size="12"/>
    </Button>
    <Button name="ReaderButton" x="232" y="480" w="36" h="48" command="reader">
      <Glyph x="8" y="14" w="20" h="20" text="reader" color="#6E6E6E"/>
    </Button>
    <Rect x="268" y="492" w="1" h="24" bg="#464646"/>
    <Button name="MoreButton" x="269" y="480" w="51" h="48" command="menu">
      <Glyph x="13" y="12" w="24" h="24" text="more" color="#FFFFFF"/>
    </Button>
  </Canvas>
</Page>
