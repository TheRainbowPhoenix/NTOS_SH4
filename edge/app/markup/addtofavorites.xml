<Page name="AddToFavoritesDialog">
  <Canvas>
    <!-- same dialog pattern as the reading-list flyout, star hero -->
    <Rect x="0" y="0" w="320" h="528" bg="#000000"/>
    <Text x="12" y="15" text="FAVORITES" color="#FFFFFF" size="18"/>
    <Rect x="0" y="78" w="320" h="180" bg="#333333"/>
    <Glyph x="134" y="172" w="52" h="52" text="star" color="#FFFFFF"/>
    <Text x="12" y="280" text="Name" color="#FFFFFF" size="14"/>
    <Button name="FavName" x="12" y="298" w="296" h="33" command="noop">
      <Text name="FavNameText" x="8" y="9" text="Test" color="#FFFFFF" size="14"/>
    </Button>
    <Button name="FavAdd" x="12" y="358" w="146" h="32" command="fav-add" bg="#2E2E2E">
      <Text x="0" y="9" w="146" text="Add" color="#FFFFFF" size="14" align="1"/>
    </Button>
    <Button name="FavCancel" x="162" y="358" w="146" h="32" command="dialog-cancel" bg="#2E2E2E">
      <Text x="0" y="9" w="146" text="Cancel" color="#FFFFFF" size="14" align="1"/>
    </Button>
  </Canvas>
</Page>
