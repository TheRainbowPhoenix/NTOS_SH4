<Page name="AddToFavoritesDialog">
  <Canvas>
    <!-- browser + scrim painted behind by the app -->
    <Rect x="12" y="132" w="296" h="260" bg="#2B2B2B" radius="8"/>
    <Text x="28" y="148" text="Add to favorites" color="#FFFFFF" size="18" bold="true"/>
    <Text x="28" y="186" text="Name" color="#9A9A9A" size="9"/>
    <TextBox name="FavName" x="28" y="200" w="264" h="36" bg="#1F1F1F" radius="2" text="Wikipedia"/>
    <Text x="28" y="248" text="Folder" color="#9A9A9A" size="9"/>
    <Button x="28" y="260" w="264" h="32" command="fav-folder">
      <Text x="0" y="8" text="Favorites" color="#FFFFFF" size="12"/>
      <Glyph x="208" y="8" w="16" h="16" text="chevron" color="#6E6E6E"/>
    </Button>
    <Button x="12" y="304" w="296" h="40" command="fav-add">
      <Text x="0" y="13" w="296" text="Add" color="#0078D7" size="14" bold="true" align="1"/>
    </Button>
    <Button x="12" y="344" w="296" h="40" command="dialog-cancel">
      <Text x="0" y="13" w="296" text="Cancel" color="#FFFFFF" size="14" align="1"/>
    </Button>
  </Canvas>
</Page>
