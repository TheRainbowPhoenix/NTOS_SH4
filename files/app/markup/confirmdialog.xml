<Page name="ConfirmDialog">
  <Canvas>
    <Rect name="CfScrim" x="0" y="0" w="320" h="528" bg="#7F7F7F"/>
    <!-- bottom sheet, no SIP -->
    <Rect x="0" y="376" w="320" h="152" bg="#FFFFFF"/>
    <Text name="ConfirmTitle" x="12" y="390" text="Delete" color="#000000" size="18"/>
    <Text name="ConfirmMessage" x="12" y="420" text="It will be removed permanently. Are you sure you want to delete?" color="#000000" size="14"/>
    <Button name="ConfirmOK" x="0" y="480" w="160" h="48" command="confirm-ok">
      <Text x="80" y="495" text="OK" color="#0078D7" size="14" align="1"/>
    </Button>
    <Button name="ConfirmCancel" x="160" y="480" w="160" h="48" command="confirm-cancel">
      <Text x="80" y="495" text="Cancel" color="#000000" size="14" align="1"/>
    </Button>
  </Canvas>
</Page>
