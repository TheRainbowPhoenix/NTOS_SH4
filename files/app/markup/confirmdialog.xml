<Page name="ConfirmDialog">
  <!-- top-anchored shard (delete_confirm.png): title + message + OK/Cancel
       over the FULL app surface from y0 (title bar covered, reference has
       no chrome above the scrim), no SIP; everything below the sheet dims
       down to the nav bar -->
  <Canvas>
    <Rect name="CfScrim" x="0" y="0" w="320" h="488" bg="#7F7F7F"/>
    <Rect x="0" y="0" w="320" h="236" bg="#FFFFFF"/>
    <Text name="ConfirmTitle" x="24" y="60" text="Delete" color="#000000" size="22"/>
    <Text x="24" y="96" text="It will be removed permanently." color="#000000" size="14"/>
    <Text x="24" y="116" text="Are you sure you want to delete?" color="#000000" size="14"/>
    <Button name="ConfirmOK" x="24" y="156" w="132" h="40" command="confirm-ok" bg="#F2F2F2">
      <Text x="0" y="13" w="132" text="OK" color="#0078D7" size="14" align="1"/>
    </Button>
    <Button name="ConfirmCancel" x="160" y="156" w="136" h="40" command="confirm-cancel" bg="#F2F2F2">
      <Text x="0" y="13" w="136" text="Cancel" color="#000000" size="14" align="1"/>
    </Button>
    <Rect x="0" y="233" w="320" h="3" bg="#0078D7"/>
  </Canvas>
</Page>
