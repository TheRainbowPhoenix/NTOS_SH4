<Page name="NewFolderDialog">
  <!-- same top-anchored prompt shape as the rename sheet (create_folder.png) -->
  <Canvas>
    <Rect name="NfScrim" x="0" y="48" w="320" h="392" bg="#7F7F7F"/>
    <Rect x="0" y="48" w="320" h="180" bg="#FFFFFF"/>
    <Text x="24" y="60" text="Create a new folder" color="#000000" size="22"/>
    <Text x="24" y="94" text="Folder name" color="#000000" size="14"/>
    <Rect name="NewFolderField" x="24" y="112" w="272" h="32" bg="#FFFFFF"/>
    <Button name="NewFolderClear" x="260" y="112" w="36" h="32" command="newfolder-clear">
      <Glyph x="10" y="8" w="16" h="16" text="x" color="#767676"/>
    </Button>
    <Button name="NewFolderOK" x="24" y="156" w="132" h="40" command="newfolder-ok" bg="#F2F2F2">
      <Text x="0" y="13" w="132" text="OK" color="#0078D7" size="14" align="1"/>
    </Button>
    <Button name="NewFolderCancel" x="160" y="156" w="136" h="40" command="newfolder-cancel" bg="#F2F2F2">
      <Text x="0" y="13" w="136" text="Cancel" color="#000000" size="14" align="1"/>
    </Button>
    <Rect x="0" y="225" w="320" h="3" bg="#0078D7"/>
  </Canvas>
</Page>
