<Page name="RenameDialog">
  <!-- top-anchored prompt (rename_folder_focused_input.png): the shard
       covers the WHOLE app surface from y0 (the app title bar included —
       W10M ContentDialogs display over everything except SIP and nav bar)
       and ends on the docked SIP (y231); the dialog is NOT screen-centered.
       Content geometry matches the reference screen rows (title y61) -->
  <Canvas>
    <Rect name="RnScrim" x="0" y="0" w="320" h="488" bg="#7F7F7F"/>
    <Rect x="0" y="0" w="320" h="228" bg="#FFFFFF"/>
    <Text name="RenameTitle" x="24" y="60" text="Rename file" color="#000000" size="22"/>
    <Text name="RenameLabel" x="24" y="94" text="File name" color="#000000" size="14"/>
    <Rect name="RenameField" x="24" y="112" w="272" h="32" bg="#FFFFFF"/>
    <Button name="RenameClear" x="260" y="112" w="36" h="32" command="rename-clear">
      <Glyph x="10" y="8" w="16" h="16" text="x" color="#767676"/>
    </Button>
    <Button name="RenameOK" x="24" y="156" w="132" h="40" command="rename-ok" bg="#F2F2F2">
      <Text x="0" y="13" w="132" text="OK" color="#0078D7" size="14" align="1"/>
    </Button>
    <Button name="RenameCancel" x="160" y="156" w="136" h="40" command="rename-cancel" bg="#F2F2F2">
      <Text x="0" y="13" w="136" text="Cancel" color="#000000" size="14" align="1"/>
    </Button>
    <!-- accent underline closing the sheet (reference: full-width blue) -->
    <Rect x="0" y="225" w="320" h="3" bg="#0078D7"/>
  </Canvas>
</Page>
