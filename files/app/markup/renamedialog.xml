<Page name="RenameDialog">
  <Canvas>
    <Rect name="RnScrim" x="0" y="0" w="320" h="528" bg="#7F7F7F"/>
    <!-- sheet docks above the SIP (fingerkb y271..528) -->
    <Rect x="0" y="139" w="320" h="132" bg="#FFFFFF"/>
    <Text name="RenameTitle" x="12" y="149" text="Rename file" color="#000000" size="18"/>
    <Text name="RenameLabel" x="12" y="175" text="File name" color="#000000" size="14"/>
    <Rect name="RenameField" x="12" y="195" w="296" h="32" bg="#FFFFFF"/>
    <Button name="RenameOK" x="0" y="227" w="160" h="44" command="rename-ok">
      <Text x="80" y="240" text="OK" color="#0078D7" size="14" align="1"/>
    </Button>
    <Button name="RenameCancel" x="160" y="227" w="160" h="44" command="rename-cancel">
      <Text x="80" y="240" text="Cancel" color="#000000" size="14" align="1"/>
    </Button>
  </Canvas>
</Page>
