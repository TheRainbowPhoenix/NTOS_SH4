<Page name="HomePage">
  <Canvas>
    <!-- page: very light warm gray (measured #F7F3F7) -->
    <Rect x="0" y="0" w="320" h="528" bg="#F7F3F7"/>
    <!-- top chrome: hamburger + music search -->
    <Button name="HamburgerButton" x="0" y="0" w="48" h="48" command="noop">
      <Glyph x="16" y="16" w="16" h="16" text="hamburger" color="#333333"/>
    </Button>
    <Button name="MusicButton" x="272" y="0" w="48" h="48" command="music">
      <Glyph x="12" y="12" w="24" h="24" text="audio" color="#5A5A5A"/>
    </Button>
    <!-- the orb paints procedurally (VEC) at (160,48) d48 -->
    <!-- greeting (Fallback_Text_8, measured y84, blue) -->
    <Text name="GreetingText" x="0" y="84" w="320" text="How can I help?" color="#3E6BE0"
          size="15" align="1"/>
    <!-- body (ProactiveControl_CortanaErrorTextBlock, 3 wrapped lines) -->
    <Text x="12" y="138" text="Go ahead and tell me to do" color="#000000" size="20"/>
    <Text x="12" y="170" text="something. Interests aren't" color="#000000" size="20"/>
    <Text x="12" y="202" text="available at the moment." color="#000000" size="20"/>
    <!-- search bar band (measured y432..480, #DEDBDE) -->
    <Rect x="0" y="432" w="320" h="48" bg="#DEDBDE"/>
    <Button name="SearchBar" x="0" y="432" w="268" h="48" command="search">
      <Text name="SearchHint" x="12" y="13" text="Type here to search" color="#000000" size="14"/>
    </Button>
    <!-- mic button: blue square, white mic glyph -->
    <Button name="MicButton" x="268" y="434" w="44" h="44" command="search">
      <Rect x="0" y="0" w="44" h="44" bg="#0078D7"/>
      <Glyph x="12" y="12" w="20" h="20" text="mic" color="#FFFFFF"/>
    </Button>
  </Canvas>
</Page>
